# 用 nginx（或宝塔、1Panel 等面板自带的 nginx）代替 Caddy 做反向代理时的示例。
# 推荐还是用 `sudo bash deploy/setup-web.sh 你的域名`（Caddy，WebSocket 不用额外配置）。
#
# 关键点：桌面版的实时信号走 WebSocket（/api/v1/stream）。nginx 默认不转发 Upgrade 头，
# 不加下面这段的话网页和 REST 都正常，但 WebSocket 握手失败，桌面版左下角会一直显示「重连中」。
# 面板用户：在站点的反向代理设置里打开「WebSocket 支持」，或把下面的 location 加进站点配置。

server {
    listen 443 ssl http2;
    server_name 你的域名;
    # ssl_certificate / ssl_certificate_key 按你的证书路径填写

    client_max_body_size 1m;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # 实时信号 WebSocket：一定要有 HTTP/1.1 + Upgrade/Connection 头，读超时调长
    location = /api/v1/stream {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
