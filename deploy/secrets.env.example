# 密钥文件：install.sh 会复制到 /etc/market-monitor/secrets.env（权限 600，只有后台服务账号和 root 能读）。
# 值一律用英文双引号括起来（systemd 和 shell 都认）。这个文件绝不要提交到 git。

# 这些值也可以在网页后台里填（只能写入，页面上不会显示原文）。

# Telegram 机器人 token（找 @BotFather 要）
TELEGRAM_BOT_TOKEN=""

# Discord 机器人 token（Discord 开发者后台 → 应用 → Bot → Reset Token），用 Discord 推送时填
DISCORD_BOT_TOKEN=""

# TradingView webhook 地址里的密钥。在网页后台打开 TradingView 转发时自动生成，一般不用手填
TRADINGVIEW_WEBHOOK_SECRET=""

# 可选：外部心跳地址，例如 healthchecks.io 的 ping URL。
# 每 60 秒访问一次；Telegram 发不出去时访问 <URL>/fail。服务死掉、VPS 断网时由心跳服务提醒你。
HEARTBEAT_URL=""

# 长桥 OpenAPI（接通美股时再填）。config.toml 里 auth = "apikey" 时填这三个：
LONGBRIDGE_APP_KEY=""
LONGBRIDGE_APP_SECRET=""
LONGBRIDGE_ACCESS_TOKEN=""

# auth = "oauth" 时只填这个，然后运行一次 sudo mm lb-login
LONGBRIDGE_OAUTH_CLIENT_ID=""
